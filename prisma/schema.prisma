// TechNova database schema.
// Relationships:
//   Category 1 ── * Product
//   Order    1 ── * OrderItem
//   Product  1 ── * OrderItem

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────

enum Role {
  ADMIN
  CUSTOMER
}

enum PaymentMethod {
  PAYHERE
  WHATSAPP
}

// Money lifecycle - independent of fulfilment.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// Stock policy: stock is decremented when the order is CREATED (inside a transaction)
// and restored when the order becomes CANCELLED or its payment becomes FAILED.
// Fulfilment lifecycle: PENDING -> CONFIRMED -> PROCESSING -> SHIPPED -> COMPLETED (shown to customers as
// "Delivered"), or CANCELLED.
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

// ───────────── Models ─────────────

// Both kinds of account live here, told apart by `role`. Admins and customers have separate
// login routes and separate session cookies, so one can never be used as the other.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String // bcrypt hash, never the plaintext password
  // No default on purpose: the code always states the role explicitly, so an account can never
  // become an admin (or a customer) by accident.
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  orders       Order[]
  cart         Cart?
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  imageUrl    String
  // Soft-delete flag: ordered products are never hard-deleted, only deactivated.
  isActive    Boolean     @default(true)
  categoryId  String
  // Restrict: a category that still has products cannot be deleted.
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]
  cartItems   CartItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

model Order {
  id               String        @id @default(cuid())
  // Autoincrement integer; displayed as TN-0001 via formatOrderNumber() in lib/utils.ts
  // (shown to customer/admin and sent in the WhatsApp message).
  orderNumber      Int           @unique @default(autoincrement())
  customerName     String
  customerEmail    String
  phone            String
  address          String
  city             String
  notes            String?
  // Authoritative total, calculated on the server from DB prices.
  total            Decimal       @db.Decimal(10, 2)
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PENDING)
  orderStatus      OrderStatus   @default(PENDING)
  // PayHere's own payment reference, stored from the verified notification.
  payherePaymentId String?
  // The customer account that placed the order. Set from the server-side session, never from the
  // request body. Optional only because orders placed before accounts existed have no owner.
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  // The tracking timeline: one row each time the order moves to a new status.
  statusHistory    OrderStatusHistory[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([userId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  // Cascade: deleting an order removes its line items.
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  // Restrict: keeps the link to history; products with orders must be deactivated, not deleted.
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  // Snapshot of what the customer actually bought and paid, immune to later edits.
  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int

  @@index([orderId])
  @@index([productId])
}

// One row per status change (the first row is written when the order is created). The customer's
// tracking timeline is read from here, so every date shown is a real event, never a guess.
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

// ───────────── Server-side cart (so a cart follows the customer across devices) ─────────────
// Guests keep their cart in the browser; after login it is merged into this one.
// The cart stores only product ids and quantities. Prices and stock are always read fresh.

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([cartId, productId])
  @@index([productId])
}
